---
import Base from "../layouts/Base.astro";
---

<Base title="Página não encontrada" description="Página não encontrada." noindex>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-4 sm:px-6">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Essa página não existe.</h1>
    <p class="mt-6"><a class="font-medium text-accent underline underline-offset-4" href="/">Ir para o início</a></p>
  </main>
</Base>
