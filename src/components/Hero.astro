---
import type { Pitch } from "../data/pitches/jotha-prime";

interface Props {
  hero: Pitch["hero"];
}

const { hero } = Astro.props;
---

<header class="pt-10 pb-8 sm:pt-20 sm:pb-12">
  <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent">{hero.eyebrow}</p>
  <blockquote class="mt-6 border-l-2 border-accent pl-4 text-lg text-muted italic sm:text-xl">
    “{hero.quote}”
  </blockquote>
  <h1 class="mt-3 text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl">
    {hero.headline}
  </h1>
  <p class="mt-6 max-w-[38rem] text-lg leading-relaxed text-muted text-pretty">{hero.lead}</p>
</header>
