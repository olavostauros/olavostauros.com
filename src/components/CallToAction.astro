---
import { site, whatsappLink } from "../data/site";
import type { Pitch } from "../data/pitches/jotha-prime";

interface Props {
  cta: Pitch["cta"];
  id: string;
}

const { cta, id } = Astro.props;
const secondary = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: "LinkedIn", href: site.linkedin },
  { label: "GitHub", href: site.github },
];
---

<section id={id} class="my-10 rounded-3xl bg-ink px-6 py-10 text-bg sm:px-10 sm:py-14">
  <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{cta.title}</h2>
  <p class="mt-3 text-lg opacity-80">{cta.text}</p>
  <a
    href={whatsappLink(cta.whatsappText)}
    target="_blank"
    rel="noopener"
    class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-7 py-4 text-lg font-semibold text-accent-ink transition-transform hover:scale-[1.02] sm:w-auto"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
      <path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.24-1.37A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.82.83-3.03-.2-.31a8.2 8.2 0 1 1 6.95 3.85Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.25-.64.8-.79.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.41-.56-.42h-.48a.92.92 0 0 0-.67.31 2.8 2.8 0 0 0-.87 2.08 4.86 4.86 0 0 0 1.02 2.58 11.1 11.1 0 0 0 4.25 3.76c1.58.68 2.2.74 3 .62.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.23-.16-.48-.29Z" />
    </svg>
    {cta.button}
  </a>
  <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm opacity-80">
    {
      secondary.map((s) => (
        <a href={s.href} class="underline underline-offset-4 hover:opacity-100" target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
          {s.label}
        </a>
      ))
    }
  </p>
</section>
